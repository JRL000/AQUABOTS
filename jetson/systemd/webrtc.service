[Unit]
Description=WebRTC camera stream (Jetson → browser)
After=network.target mavproxy.service signaling.service
Wants=network.target signaling.service

[Service]
ExecStart=/bin/bash -c 'exec /usr/bin/python3 -u /home/mayra/webrtc_jetson.py > /tmp/webrtc.log 2>&1'
WorkingDirectory=/home/mayra
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
